{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies",
    "automated"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Incus Terraform provider version in Terranix config",
      "managerFilePatterns": [
        "/(^|/)infra/config\\.nix$/"
      ],
      "matchStrings": [
        "terraform\\.required_providers\\.incus = \\{[\\s\\S]*?source = \"(?<packageName>[^\"]+)\";[\\s\\S]*?version = \"(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "terraform-provider",
      "registryUrlTemplate": "https://registry.opentofu.org"
    }
  ],
  "packageRules": [
    {
      "description": "actions/checkout v6+ breaks git auth on the Forgejo runner: it writes hardcoded GitHub gitdir includeIf credential paths that never match the runner workspace. Stay on v5 until upstream fixes non-GitHub runners (actions/checkout#2321)",
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "https://github.com/actions/checkout"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Automerge the GitHub Actions used by the Forgejo workflows once the PR checks pass",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "Renovate releases too often, constrain to weekly PRs",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "extends": [
        "schedule:weekly"
      ]
    }
  ]
}
