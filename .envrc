# shellcheck shell=bash
export GC_INITIAL_HEAP_SIZE=2G
use flake "git+file:."

export NH_FLAKE=git+file:.

# Local secrets and machine-specific overrides live in .envrc.local, which is gitignored.
if [ -f .envrc.local ]; then
  # shellcheck disable=SC1091
  source .envrc.local
  watch_file .envrc.local
fi
